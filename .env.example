# Optional. The swarm runs offline with the deterministic Ops planner when unset.
ANTHROPIC_API_KEY=

# Required for `swarm run --live` and `--commit-source live`.
# Never put this in config.yaml — `swarm init` prints the line to add here.
GITHUB_TOKEN=

# Defaults match docker-compose.yml (overridden by config.yaml for --live).
PROMETHEUS_URL=http://localhost:9090
